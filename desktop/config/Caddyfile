# Servidor web de la instalación local de pro8.
#
# Escucha solo en 127.0.0.1: el terminal es para la PC donde está instalado, no
# para exponer el sistema a la red del local. Si en algún momento se quiere
# compartir con otra máquina, hay que cambiarlo acá a propósito y no por
# accidente.

{
	admin off
	auto_https off
	# El navegador es local: los logs de acceso solo llenarían el disco.
	log {
		output file ../logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		level ERROR
	}
}

127.0.0.1:8099, localhost:8099 {
	root * ../app/public

	encode gzip

	php_fastcgi 127.0.0.1:9123 {
		# php-cgi corre en la misma carpeta que el sistema, así que los
		# índices se resuelven contra app/public.
		index index.php
	}

	file_server

	# Subidas grandes: respaldos, certificados, imágenes de productos.
	request_body {
		max_size 100MB
	}

	header {
		# El sistema se sirve solo a esta PC; se evita que quede cacheado
		# entre actualizaciones y muestre una versión vieja.
		Cache-Control "no-store, must-revalidate"
		-Server
	}
}
