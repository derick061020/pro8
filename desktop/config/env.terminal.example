# Plantilla del .env de un terminal Windows.
#
# El instalador la copia a app\.env reemplazando los valores entre llaves.
# Las diferencias con un pro8 online son a propósito:
#
#  - Puerto 3399 en MariaDB y 8099 en el servidor web, para no chocar con un
#    XAMPP o un MySQL que ya estuviera instalado en la PC.
#  - Sin Redis: en Windows es una fuente de problemas y acá no aporta nada,
#    porque hay un solo usuario.
#  - Colas sincrónicas: no hay un worker corriendo, así que un job encolado
#    se quedaría esperando para siempre.

APP_NAME=pro8
APP_ENV=production
APP_KEY={APP_KEY}
APP_DEBUG=false

APP_URL_BASE=localhost:8099
APP_URL=http://${APP_URL_BASE}

DB_CONNECTION=system
DB_HOST=127.0.0.1
DB_PORT=3399
DB_DATABASE=pro8
DB_USERNAME=root
DB_PASSWORD=

# Sin servicios externos: todo en disco.
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

SESSION_LIFETIME=600

LOG_CHANNEL=daily
LOG_LEVEL=warning

# El terminal no manda correos: los envía el servidor online cuando recibe la
# venta sincronizada.
MAIL_MAILER=log

TENANCY_DATABASE_AUTO_DELETE=false
TENANCY_DATABASE_AUTO_DELETE_USER=false
